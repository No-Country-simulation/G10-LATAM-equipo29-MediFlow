# Copiar a .env.local. No usar NEXT_PUBLIC_ para ninguna credencial.
OCI_REGION=us-phoenix-1
OCI_NAMESPACE=axw7vrue8uot
# Bucket fijo en código: mediflow-documentos-clinicos

# api_key: local o despliegue con variables de entorno del servidor.
OCI_AUTH_MODE=api_key
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
# PEM completo. Admite saltos reales dentro de comillas o secuencias \n.
OCI_PRIVATE_KEY=
OCI_PRIVATE_KEY_PASSPHRASE=

# Alternativa local: OCI_AUTH_MODE=config_file (ignora las variables de API key).
# Por defecto usa ~/.oci/config y el perfil DEFAULT.
OCI_CONFIG_FILE=
OCI_CONFIG_PROFILE=DEFAULT

# Clasificación de documentos con Gemini (solo servidor, nunca NEXT_PUBLIC_).
# Clave de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY= AQ.Ab8RN6KMpNDk9y95A-qizwZiWfqxItZ8VraxNK8NJquBjCDvhw
# Opcional. Por defecto: gemini-3.5-flash-lite
GEMINI_MODEL= "gemini-3.5-flash-lite";
